{
  "$schema": "catalog.schema",
  "name": "OnlineManager",
  "version": 1,
  "css": "dist/components.css",
  "js": "dist/components.js",
  "icons": {
    "set": "Eva Icons",
    "variant": "outline",
    "usage": "<i data-eva=\"trash-2-outline\"></i> puis eva.replace() — ou le SVG exporté depuis https://akveo.github.io/eva-icons/"
  },
  "tokens": {
    "--a": "#8A3AAF — violet, toute action",
    "--a-h": "#783298 — violet hover",
    "--a-p": "#662B81 — violet pressed",
    "--a1": "#F8F1FB — surface teintée violet",
    "--a2": "#E0CAEA — bordure teintée violet",
    "--a-dark": "#9B4BC4 — violet sur fond sombre",
    "--nav-act": "#E2006E — entrée active du menu gauche et wordmark, nulle part ailleurs",
    "--s": "#3B82F6 — focus des champs de saisie uniquement",
    "--s1": "#EFF6FF — anneau de focus",
    "--d": "#B42318 — destructif",
    "--d1": "#FEF3F2 — surface destructive",
    "--d2": "#FCD9D6 — bordure destructive",
    "--t1": "#111827 — texte principal",
    "--t2": "#4B5563 — texte secondaire",
    "--t3": "#9CA3AF — texte tertiaire",
    "--bd": "#E5E7EB — bordures",
    "--bg": "#F3F4F6 — fond de page",
    "--ps": "#F7F8FA — surface légère",
    "--row-even": "#F9FAFB — ligne paire",
    "--row-hover": "#F1F3F5 — ligne survolée",
    "--row-active": "#E3E6EA — ligne cliquée",
    "--sw": "220px — largeur du menu gauche",
    "--ch": "36px — hauteur des contrôles",
    "--r": "8px — rayon standard",
    "--rl": "12px — rayon des cartes"
  },
  "page": {
    "skeleton": "<body class=\"app\"><header class=\"topbar\">…</header><div class=\"layout\"><aside class=\"sidebar\">…</aside><main class=\"main\"><div class=\"content\">…</div></main></div><script src=\"dist/components.js\" defer></script></body>",
    "classes": ["app", "topbar", "tb-slot", "tb-appn", "tb-burger", "tb-body", "tb-store", "tb-cw", "tb-cl", "tb-ics", "tbi", "tbsep", "tb-av", "apps-wrap", "apps-drop", "apps-hd", "app-row", "app-ic", "app-nm", "app-sub", "layout", "sidebar", "sb-toggle", "sbt-btn", "nav", "ni", "ni-group", "sub-nav", "ni-sub", "chevron", "nb", "main", "content", "bc-wrap", "bc-item", "bc-sep", "bc-cur", "ph", "ph-l", "ph-title", "ph-ct", "ph-actions"],
    "rules": [
      "Le squelette vient d'un template, il n'est pas réécrit.",
      "Exactement une entrée .ni.act dans le menu, celle de la page.",
      "Le fil d'Ariane .bc-wrap précède l'en-tête .ph."
    ]
  },
  "components": [
    {
      "id": "button",
      "name": "Bouton",
      "base": "btn",
      "element": "button | a",
      "variants": {
        "weight": ["primary", "secondary", "tertiary"],
        "tone": ["neutral", "critical"],
        "size": ["xs", "sm", "lg"],
        "shape": ["icon-only", "block", "pill"],
        "state": ["is-loading", "is-disabled", "on-dark", "neutral-dark"]
      },
      "children": ["btn-count"],
      "snippet": "<button class=\"btn primary\">Enregistrer</button>",
      "snippets": {
        "primary": "<button class=\"btn primary\">Publier la formation</button>",
        "secondary": "<button class=\"btn secondary\">Valider</button>",
        "default": "<button class=\"btn\">Exporter</button>",
        "tertiary": "<button class=\"btn tertiary\">En savoir plus</button>",
        "critical": "<button class=\"btn critical\">Supprimer</button>",
        "critical-confirm": "<button class=\"btn primary critical\">Supprimer définitivement</button>",
        "icon-only": "<button class=\"btn tertiary neutral icon-only\" aria-label=\"Supprimer la formation\"><i data-eva=\"trash-2-outline\" aria-hidden=\"true\"></i></button>",
        "loading": "<button class=\"btn primary is-loading\"><span>Publication…</span></button>",
        "with-icon": "<button class=\"btn secondary\"><i data-eva=\"save-outline\" aria-hidden=\"true\"></i>Enregistrer</button>"
      },
      "rules": [
        "Une seule .primary par écran.",
        "Le ton se pose sur un poids : .critical seul = bordé rouge, .primary.critical = plein rouge.",
        "icon-only exige aria-label.",
        "disabled est l'attribut natif, jamais opacity.",
        "Sur les sidebars sombres : .primary.on-dark et .neutral-dark."
      ]
    },
    {
      "id": "button-group",
      "name": "Groupe de boutons",
      "base": "btn-group",
      "snippet": "<div class=\"btn-group\"><button class=\"btn sm\">Liste</button><button class=\"btn sm\">Grille</button></div>"
    },
    {
      "id": "split-button",
      "name": "Split button",
      "base": "btn-split",
      "snippet": "<div class=\"btn-split\"><button class=\"btn secondary\">Exporter en PDF</button><button class=\"btn secondary\" aria-label=\"Autres formats\"><i data-eva=\"chevron-down-outline\" aria-hidden=\"true\"></i></button></div>"
    },
    {
      "id": "segmented",
      "name": "Segmented control",
      "base": "btn-seg",
      "snippet": "<div class=\"btn-seg\"><button class=\"active\" onclick=\"segPick(this)\">Jour</button><button onclick=\"segPick(this)\">Semaine</button></div>"
    },
    {
      "id": "action-bar",
      "name": "Barre d'actions",
      "base": "btn-bar",
      "children": ["spacer"],
      "snippet": "<div class=\"btn-bar\"><button class=\"btn critical\">Supprimer</button><span class=\"spacer\"></span><button class=\"btn\">Annuler</button><button class=\"btn primary\">Enregistrer</button></div>",
      "rules": ["La confirmation est toujours en dernier, à droite."]
    },
    {
      "id": "field",
      "name": "Champ de saisie",
      "base": "form-field",
      "children": ["form-input", "req", "form-hint", "form-error"],
      "input-modifiers": ["ro", "has-error"],
      "snippet": "<div class=\"form-field\"><label>Raison sociale<span class=\"req\">*</span></label><input type=\"text\" class=\"form-input\"></div>",
      "snippets": {
        "hint": "<div class=\"form-field\"><label>N° SIRET</label><input type=\"text\" class=\"form-input\"><span class=\"form-hint\">14 chiffres, sans espaces</span></div>",
        "error": "<div class=\"form-field\"><label>Code postal</label><input type=\"text\" class=\"form-input has-error\"><span class=\"form-error\">Le code postal doit compter 5 chiffres</span></div>",
        "readonly": "<input type=\"text\" class=\"form-input ro\" value=\"42478033600014\" readonly>",
        "textarea": "<textarea class=\"form-input\"></textarea>"
      },
      "rules": ["Le label est au-dessus, jamais en placeholder.", "Lecture seule garde le texte lisible ; désactivé l'efface."]
    },
    {
      "id": "form-grid",
      "name": "Grille de champs",
      "base": "form-grid",
      "variants": { "columns": ["col-full", "cols-3"] },
      "snippet": "<div class=\"form-grid\"><div class=\"form-field\">…</div><div class=\"form-field\">…</div></div>",
      "rules": ["Le nombre de colonnes suit la longueur attendue de la valeur."]
    },
    {
      "id": "form-section",
      "name": "Section de formulaire",
      "base": "fs-block",
      "children": ["fs-header", "fs-icon", "fs-title", "fs-card"],
      "snippet": "<div class=\"fs-block\"><div class=\"fs-header\"><div class=\"fs-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:12px;height:12px\">…</svg></div><div class=\"fs-title\">Informations générales</div></div><div class=\"fs-card\"><div class=\"form-grid col-full\">…</div></div></div>",
      "rules": ["Toujours dans une .col d'un .form-body, jamais sur toute la largeur."]
    },
    {
      "id": "form-page",
      "name": "Page de réglages",
      "base": "form-body",
      "children": ["col"],
      "snippet": "<div class=\"form-body\"><div class=\"col\">…fs-block…</div><div class=\"col\">…fs-block…</div></div>"
    },
    {
      "id": "upload",
      "name": "Import de fichier",
      "base": "upload-row",
      "children": ["upload-side", "upload-ic", "upload-name", "upload-sub"],
      "snippet": "<div class=\"upload-row\"><div class=\"upload-side\"><div class=\"upload-ic\"><i data-eva=\"image-outline\"></i></div><div><div class=\"upload-name\">Importez le logo</div><div class=\"upload-sub\">20 Mo max · .png, .jpg</div></div></div><button class=\"btn secondary\">Importer</button></div>"
    },
    {
      "id": "choice-card",
      "name": "Carte de choix",
      "base": "form-card-check",
      "children": ["check-circle", "check-label"],
      "snippet": "<label class=\"form-card-check active\"><input type=\"radio\" name=\"x\" checked onchange=\"toggleCard(this)\"><div class=\"check-circle\"></div><div class=\"check-label\">Validation requise par un administrateur</div></label>"
    },
    {
      "id": "switch",
      "name": "Bascule",
      "base": "form-switch",
      "children": ["slider"],
      "snippet": "<label class=\"form-switch\"><input type=\"checkbox\" checked><span class=\"slider\"></span></label>",
      "rules": ["Pour un réglage appliqué immédiatement. Sinon, case à cocher."]
    },
    {
      "id": "checkbox",
      "name": "Case à cocher",
      "base": "form-check-inline",
      "snippet": "<label class=\"form-check-inline\"><input type=\"checkbox\"> Envoyer une notification</label>"
    },
    {
      "id": "dropdown",
      "name": "Dropdown / sélecteur",
      "base": "w-dd-wrap",
      "variants": { "wrap": ["block"], "button": ["field", "sm", "tb"] },
      "children": ["w-dd-btn", "w-dd-menu", "w-dd-item", "chev", "ph"],
      "snippet": "<div class=\"w-dd-wrap\"><button class=\"w-dd-btn\" onclick=\"toggleDD(this)\"><span>Annuel</span><svg class=\"chev\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg></button><div class=\"w-dd-menu\"><div class=\"w-dd-item active\">Annuel</div><div class=\"w-dd-item\">Mensuel</div></div></div>",
      "snippets": {
        "form-field": "<div class=\"w-dd-wrap block\"><button class=\"w-dd-btn field\" onclick=\"toggleDD(this)\"><span>France</span><svg class=\"chev\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg></button><div class=\"w-dd-menu\"><div class=\"w-dd-item active\">France</div><div class=\"w-dd-item\">Suisse</div></div></div>",
        "placeholder": "<button class=\"w-dd-btn field\" onclick=\"toggleDD(this)\"><span class=\"ph\">Sélectionnez un pays</span>…</button>"
      },
      "rules": ["Jamais de <select> natif.", "Un placeholder est dans .ph sur le bouton, pas une option de la liste."]
    },
    {
      "id": "table",
      "name": "Tableau",
      "base": "tcard",
      "children": ["tw", "thr", "thr-filter", "srt", "rez", "th-search", "cgear-th", "cgear", "cpanel", "cph", "cpt", "cprst", "cplist", "crow", "cdg", "cck", "clbl", "catd", "rdots", "rmenu", "rmi", "rmdiv", "cn", "ava", "nmain", "nsub", "stb", "stdon", "stdoff", "ston", "stoff", "cv", "dc", "mcel", "npill", "mwrap", "mtip", "mtit", "mit", "mdt", "tfoot", "fi", "pgn", "pb", "lpp-wrap", "lpp-lbl", "lpp-btn", "cmp", "tail"],
      "snippet": "voir templates/liste.html",
      "rules": [
        "Deux lignes d'en-tête : tr.thr (libellés + .rez) puis tr.thr-filter (input.th-search ou dropdown .sm).",
        "La dernière colonne est .cgear-th en en-tête et td.catd en corps ; elle porte la roue et le menu de ligne.",
        "Les fonds de ligne sont ceux du système, pas de couleur par ligne.",
        "Le menu de ligne finit par un .rmdiv puis les actions d'état, le destructif en .rmi.dn en dernier."
      ]
    },
    {
      "id": "widget",
      "name": "Widget de statistiques",
      "base": "w",
      "children": ["w-head", "w-ico", "w-title", "w-info", "w-controls", "w-badge", "w-ctrl-btn", "w-filters", "w-filter-btn", "w-filter-sep", "w-dots", "w-body", "empty-chart", "empty-bar", "empty-msg"],
      "container": "wgrid",
      "snippet": "voir templates/dashboard.html",
      "rules": ["Dans une .wgrid ; .full pour un widget pleine largeur."]
    },
    {
      "id": "badge",
      "name": "Badge",
      "base": "pbadge",
      "variants": { "style": ["filled", "outline", "gray", "green"] },
      "snippet": "<span class=\"pbadge gray\">Non commencé</span>"
    },
    {
      "id": "modal",
      "name": "Modale",
      "base": "modal-mock",
      "children": ["modal-header", "modal-icon", "modal-title-wrap", "modal-title", "modal-subtitle", "modal-close", "modal-body", "modal-footer", "drop-zone", "drop-icon", "drop-text", "drop-sub"],
      "snippet": "voir index.html → Modales & Overlays"
    }
  ]
}
